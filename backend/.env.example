APP_NAME="ApniKhareedari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Seeded demo accounts (used by database/seeders). Change before any real deployment.
ADMIN_SEED_EMAIL=admin@apnikhareedari.pk
ADMIN_SEED_PASSWORD=Admin@12345
CUSTOMER_SEED_EMAIL=customer@apnikhareedari.pk
CUSTOMER_SEED_PASSWORD=Customer@12345

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# When running via the provided docker-compose.yml, DB_HOST=mysql and MAIL_HOST=mailhog
# (Docker service names). If running Laravel outside Docker, point these at 127.0.0.1
# and the exposed host ports instead.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apnikhareedari
DB_USERNAME=akd_user
DB_PASSWORD=akd_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev uses Mailhog (the docker-compose `mailhog` service) so nothing
# ever leaves your machine. For production, point these at your real mailbox
# instead — e.g. for a cPanel-style host:
#   MAIL_HOST=mail.yourdomain.tld   (confirm the exact hostname in your
#                                    hosting control panel's "Connect Devices"
#                                    / "Set up Mail Client" page)
#   MAIL_PORT=587
#   MAIL_SCHEME=        (587 = STARTTLS, auto-negotiated when left blank;
#                         use 465 + MAIL_SCHEME=smtps for implicit TLS instead)
#   MAIL_USERNAME=support@yourdomain.tld
#   MAIL_PASSWORD=<real mailbox password — never commit this>
#   MAIL_FROM_ADDRESS="support@yourdomain.tld"  (match the authenticated
#                                                 mailbox — many SMTP hosts
#                                                 reject a From address that
#                                                 doesn't match the logged-in
#                                                 account/domain)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@apnikhareedari.pk"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
